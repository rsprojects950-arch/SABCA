{
  "expo": {
    "name": "SABCA",
    "slug": "sabca-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon_square.jpg",
    "scheme": "sabcaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.infraxpert.sabca",
      "buildNumber": "4",
      "infoPlist": {
        "NSFaceIDUsageDescription": "SABCA uses Face ID or Touch ID to provide secure, biometric authentication into your member account.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SABCA needs camera access so you can take and upload a profile photo and capture photos when submitting grievance documentation.",
        "NSPhotoLibraryUsageDescription": "SABCA needs access to your photo library to allow you to select and upload your profile picture and grievance attachments.",
        "NSPhotoLibraryAddUsageDescription": "SABCA needs permission to save your digital member ID card directly to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app_icon_round.jpg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.infraxpert.sabca",
      "versionCode": 4
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "supportsSceneLifecycle": true
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sabca_new_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c1f22f4e-101c-440d-ad2a-05c1a4ef6504"
      }
    }
  }
}